rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny all by default
    match /{document=**} {
      allow read, write: false;
    }

    // -------------------------------------------------------------
    // STUDENT ACCOUNTS & PROFILES
    // -------------------------------------------------------------
    match /students/{userId} {
      // Students can only read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;

      // Students can update their profile and activeSessionId on login,
      // but cannot tamper with course entitlements, expiry dates, or admin flags
      allow create: if request.auth != null && request.auth.uid == userId
                    && (!request.resource.data.keys().hasAny(['entitlement', 'isAdmin']));

      allow update: if request.auth != null && request.auth.uid == userId
                    // Prevent client-side escalation of course entitlement or expiry
                    && (
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['entitlement', 'isAdmin'])
                      || request.auth.token.admin == true
                    );

      // Student Practice History Subcollection
      match /practice_history/{recordId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Only allow writes if session is not revoked
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false; // Practice history is immutable
      }

      // Student Active Sessions Subcollection
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // -------------------------------------------------------------
    // PUBLIC COURSE PACKAGES & CURRICULUM (READ-ONLY)
    // -------------------------------------------------------------
    match /courses/{courseId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
