rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.admin == true
        && request.auth.token.role == 'admin';
    }

    // -------------------------------------------------------------------------
    // STUDENTS: Students can read/update safe profile fields on their own doc.
    // Cannot self-assign roles, admin privileges, entitlements, or active status.
    // -------------------------------------------------------------------------
    match /students/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Safe initial creation by student client if needed (no privileged keys)
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny([
          'role', 'isAdmin', 'entitlement', 'activeCourseIds', 'status', 'verifiedByAdminId'
        ])
        && (!request.resource.data.keys().hasAny(['email']) || request.resource.data.email == request.auth.token.email);

      // Safe profile updates only
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isAdmin', 'entitlement', 'activeCourseIds', 'status', 'uid', 'id', 'email', 'googleUid', 'passwordHash'
        ]);

      allow delete: if false; // Account deletion goes through verified backend API

      match /practice_history/{recordId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }

      match /sessions/{sessionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false; // Managed strictly by backend Admin SDK
      }
    }

    // -------------------------------------------------------------------------
    // COURSES: Active courses are readable; all writes go through Admin SDK
    // -------------------------------------------------------------------------
    match /courses/{courseId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // ENROLLMENTS, PURCHASES, EXAM SCHEDULES & EXAM ATTEMPTS
    // Students can read ONLY their own records; writes go strictly via backend.
    // -------------------------------------------------------------------------
    match /enrollments/{enrollmentId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if false;
    }

    match /purchases/{purchaseId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if false;
    }

    match /examSchedules/{scheduleId} {
      allow read: if (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.studentId == request.auth.uid)) || isAdmin();
      allow write: if false;
    }

    match /examAttempts/{attemptId} {
      allow read: if (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.studentId == request.auth.uid)) || isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // NOTIFICATIONS: Students read own & mark read-only; no arbitrary creation
    // -------------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.read is bool;
      allow create, delete: if false;
    }

    // -------------------------------------------------------------------------
    // RESTRICTED SERVER-ONLY COLLECTIONS
    // Clients must NEVER read or write coupons, redemptions, admins, resets, logs
    // -------------------------------------------------------------------------
    match /coupons/{couponId} {
      allow read, write: if false;
    }

    match /couponRedemptions/{redemptionId} {
      allow read, write: if false;
    }

    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /passwordResets/{resetId} {
      allow read, write: if false;
    }

    match /idempotencyKeys/{keyId} {
      allow read, write: if false;
    }
  }
}
