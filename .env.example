# ==============================================================================
# Typing Thalaiva — Backend & Admin Portal Environment Variables
# Copy this file to .env and fill in real credentials before production deploy.
# Never commit .env to version control or expose secrets in mobile/web clients.
# ==============================================================================

PORT=4000
NODE_ENV=development

# Cryptographic secret used to sign student & admin JWT session tokens (min 32 chars)
JWT_SECRET=replace-with-a-strong-random-64-char-hex-secret

# Optional CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:4000,http://localhost:3000,https://localhost,capacitor://localhost

# Database storage file path (atomic persistent JSON store; swap in SQL/Postgres adapter via backend/db.js)
DB_PATH=backend/data/store.json

# Google OAuth 2.0 Web Client ID (used to verify Google ID tokens via tokeninfo / Firebase)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Admin Bootstrap Credentials (used ONLY server-side by seed script / initial bootstrap)
ADMIN_BOOTSTRAP_NAME=Institute Administrator
ADMIN_BOOTSTRAP_EMAIL=admin@srikalaimagal.in
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeToAStrongAdminPassword!

# Payment Gateway Keys (Razorpay / Stripe / Play Billing verification)
PAYMENT_WEBHOOK_SECRET=replace-with-razorpay-or-stripe-webhook-secret
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me_razorpay_secret
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
