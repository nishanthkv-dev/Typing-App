# ==============================================================================
# Typing Thalaiva — Production & Firebase Environment Variables
# Copy to .env (for local/VM) or set in your hosting platform's secret manager.
# NEVER commit .env or Firebase private service-account keys to Git!
# ==============================================================================

PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database driver: 'firestore' (recommended for cloud) or 'json' (local fallback)
# If omitted, automatically selects 'firestore' whenever Firebase Admin credentials are set.
DB_DRIVER=firestore
DB_PATH=backend/data/store.json

# Cryptographic secret used to sign backend session JWTs (required in production)
JWT_SECRET=replace-with-a-strong-random-64-char-hex-secret

# Allowed CORS origins (include your web admin domain and Capacitor origins)
ALLOWED_ORIGINS=http://localhost:4000,https://localhost,http://localhost,capacitor://localhost

# ==============================================================================
# FIREBASE ADMIN SDK (Backend Server-Side Verification & Firestore Access)
# Provide EITHER FIREBASE_SERVICE_ACCOUNT_PATH OR FIREBASE_SERVICE_ACCOUNT_JSON
# ==============================================================================
FIREBASE_PROJECT_ID=
# Path to downloaded Firebase service account JSON (keep gitignored):
FIREBASE_SERVICE_ACCOUNT_PATH=
# Or inline JSON / base64-encoded JSON string (ideal for Render/Railway/Fly/Cloud Run):
FIREBASE_SERVICE_ACCOUNT_JSON=

# ==============================================================================
# FIREBASE CLIENT WEB CONFIG (Public App Identity — Non-Secret)
# Used by Web Admin Portal & Student App runtime config endpoint (/api/public-config)
# ==============================================================================
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Google OAuth 2.0 Web Client ID (from Firebase Console -> Auth -> Google -> Web SDK config)
GOOGLE_CLIENT_ID=

# ==============================================================================
# ADMIN AUTHORIZATION (Never hardcoded in frontend/mobile bundles)
# Comma-separated emails permitted to access the separate Web Admin Portal
# ==============================================================================
ADMIN_ALLOWED_EMAILS=admin@srikalaimagal.in
ADMIN_BOOTSTRAP_NAME=Institute Administrator
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ==============================================================================
# RATE LIMITING & PAYMENT GATEWAY SECRETS
# ==============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=25
RATE_LIMIT_CHECKOUT_MAX=40

# PhonePe Standard Checkout (Sandbox by default; never put live secrets in repo)
PHONEPE_ENV=sandbox
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox

PAYMENT_WEBHOOK_SECRET=replace-with-razorpay-or-stripe-webhook-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional transactional email provider for password-reset emails (Resend HTTPS API)
# Note: Firebase Auth sendPasswordResetEmail() works out-of-the-box when Firebase Web SDK is active.
RESEND_API_KEY=
EMAIL_FROM=no-reply@srikalaimagal.in
APP_PUBLIC_URL=
