{
  "name": "typing-thalaiva",
  "version": "1.0.0",
  "description": "Typing Thalaiva – Tamil & English typing tutor wrapped as a native Android app via Capacitor",
  "private": true,
  "scripts": {
    "build": "echo \"Static app – no build step required\" && exit 0",
    "qa": "node run_playwright_qa.js",
    "cap:sync": "npx cap sync android",
    "cap:copy": "npx cap copy android",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.65.0"
  }
}
